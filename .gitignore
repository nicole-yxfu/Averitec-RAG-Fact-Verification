# ─── Secrets (NEVER commit) ──────────────────────────────────────────
.env

# ─── System / IDE ────────────────────────────────────────────────────
.DS_Store
__pycache__/
*.pyc
*.bak

# ─── Trained models (large binaries) ─────────────────────────────────
bin/*.pkl
bin/*.pt
bin/*.bin

# ─── Large regeneratable caches (kept local, never committed) ────────
results/bm25_corpus_cache/       # ~32 MB, ~10 h to rebuild via warmup_dev_corpus.py
results/bm25_ranking_cache/      # per-claim BM25 rankings, regeneratable
results/duckduckgo_cache/        # per-query DDG snippets, regeneratable (rate-limited)
results/*_retrieval_cache.json   # large retrieval caches; re-run retrieval to rebuild
results/bm25_baseline_*_top5*.json
results/dense_v2_*_pool30_top5_cache.json

# ─── Data ────────────────────────────────────────────────────────────
# Official + derived AVeriTeC splits ARE committed (≤10 MB each) so the repo
# reproduces out of the box. Only the deprecated debug subset is excluded.
data/internal_dev_mini.json

# ─── Logs / temp ─────────────────────────────────────────────────────
*.log

# ─── Virtual envs ────────────────────────────────────────────────────
.venv/
venv/
